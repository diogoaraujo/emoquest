# Porta da API
PORT=3333
# Postgres de produção (Neon, Supabase, RDS...). Deixe vazio para usar PGlite local em PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite
# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# URL pública do frontend (usada nos links e QR Codes das salas)
PUBLIC_APP_URL=http://localhost:5173
AUTH_TOKEN_TTL_DAYS=7
CONSENT_VERSION=2026-10
